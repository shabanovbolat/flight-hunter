# Supabase project (local: values printed by `supabase start` / `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — NEVER expose to the browser. Used to create creator accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used in QR codes and share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
